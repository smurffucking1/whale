	local PickerHue = 0
	local PickerSaturation = 1
	local PickerValue = 1
	local PickerAlpha = 1

	local PickerOpen = false
	local ActiveColorCallback = nil

	local PickingSaturationValue = false
	local PickingHue = false
	local PickingAlpha = false

	local function pickerColor()
		return Color3.fromHSV(
			PickerHue,
			PickerSaturation,
			PickerValue
		)
	end

	local function refreshPicker()
		local Selected = pickerColor()

		SaturationValuePanel.BackgroundColor3 = Color3.fromHSV(
			PickerHue,
			1,
			1
		)

		AlphaColourLayer.BackgroundColor3 = Selected

		ColorPreview.BackgroundColor3 = Selected
		ColorPreview.BackgroundTransparency = 1 - PickerAlpha

		SaturationValueThumb.Position = UDim2.new(
			PickerSaturation,
			0,
			1 - PickerValue,
			0
		)

		HueThumb.Position = UDim2.new(
			0.5,
			0,
			PickerHue,
			0
		)

		AlphaThumb.Position = UDim2.new(
			PickerAlpha,
			0,
			0.5,
			0
		)

		AlphaLabel.Text = tostring(
			math.floor(PickerAlpha * 100 + 0.5)
		) .. "%"

		local R = math.floor(Selected.R * 255 + 0.5)
		local G = math.floor(Selected.G * 255 + 0.5)
		local B = math.floor(Selected.B * 255 + 0.5)

		HexLabel.Text = string.format(
			"#%02X%02X%02X",
			R,
			G,
			B
		)
	end

	local function setSaturationValue(MousePosition)
		local Position = SaturationValuePanel.AbsolutePosition
		local Size = SaturationValuePanel.AbsoluteSize

		if Size.X <= 0 or Size.Y <= 0 then
			return
		end

		PickerSaturation = clamp(
			(MousePosition.X - Position.X) / Size.X,
			0,
			1
		)

		PickerValue = 1 - clamp(
			(MousePosition.Y - Position.Y) / Size.Y,
			0,
			1
		)

		refreshPicker()
	end

	local function setHue(MousePosition)
		local Position = HueTrack.AbsolutePosition
		local Size = HueTrack.AbsoluteSize

		if Size.Y <= 0 then
			return
		end

		PickerHue = clamp(
			(MousePosition.Y - Position.Y) / Size.Y,
			0,
			1
		)

		refreshPicker()
	end

	local function setAlpha(MousePosition)
		local Position = AlphaTrack.AbsolutePosition
		local Size = AlphaTrack.AbsoluteSize

		if Size.X <= 0 then
			return
		end

		PickerAlpha = clamp(
			(MousePosition.X - Position.X) / Size.X,
			0,
			1
		)

		refreshPicker()
	end

	local function closeColorPicker()
		PickerOpen = false
		ActiveColorCallback = nil

		PickingSaturationValue = false
		PickingHue = false
		PickingAlpha = false

		ColorModal.Visible = false
		ModalDim.Visible = false
	end

	local function openColorPicker(
		TitleText,
		StartingColor,
		StartingAlpha,
		Callback
	)
		local Hue, Saturation, Value = StartingColor:ToHSV()

		PickerHue = Hue
		PickerSaturation = Saturation
		PickerValue = Value
		PickerAlpha = clamp(StartingAlpha or 1, 0, 1)

		ActiveColorCallback = Callback
		PickerOpen = true

		ModalTitle.Text = TitleText

		refreshPicker()

		ModalDim.Visible = true
		ColorModal.Visible = true
	end

	SaturationValuePanel.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			PickingSaturationValue = true
			setSaturationValue(Input.Position)
		end
	end)

	HueTrack.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			PickingHue = true
			setHue(Input.Position)
		end
	end)

	AlphaTrack.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			PickingAlpha = true
			setAlpha(Input.Position)
		end
	end)

	SaturationValueThumb.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			PickingSaturationValue = true
		end
	end)

	HueThumb.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			PickingHue = true
		end
	end)

	AlphaThumb.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			PickingAlpha = true
		end
	end)

	ApplyColourButton.MouseButton1Click:Connect(function()
		if ActiveColorCallback then
			ActiveColorCallback(
				pickerColor(),
				PickerAlpha
			)
		end

		closeColorPicker()
	end)

	CancelColourButton.MouseButton1Click:Connect(closeColorPicker)
	ModalDim.MouseButton1Click:Connect(closeColorPicker)

	-- Window object
	local Window = {}

	Window.Name = WindowName
	Window.ConfigName = ConfigName
	Window.Gui = ScreenGui
	Window.Main = Main
	Window.Theme = Theme
	Window.Tabs = {}
	Window.SelectedTab = nil

	local function getControlKey(Tab, Name)
		return tostring(Tab.Name) .. "::" .. tostring(Name)
	end

	function Window:_SaveControl(Tab, Name, Value)
		Config.Controls[getControlKey(Tab, Name)] = Value
		saveConfig()
	end

	function Window:_LoadControl(Tab, Name, Default)
		local Value = Config.Controls[getControlKey(Tab, Name)]

		if Value == nil then
			return Default
		end

		return Value
	end

	function Window:SetTheme(NewTheme)
		if type(NewTheme) ~= "table" then
			return
		end

		for ThemeKey, NewColor in pairs(NewTheme) do
			if Theme[ThemeKey] and typeof(NewColor) == "Color3" then
				Theme[ThemeKey] = NewColor

				if Config.Theme[ThemeKey] then
					Config.Theme[ThemeKey] = colorToTable(NewColor)
				end

				refreshThemeKey(ThemeKey)
			end
		end

		saveConfig()
	end

	function Window:SetOpacity(Value)
		GlobalOpacity = clamp(tonumber(Value) or 0, 0, 0.85)
		Config.Opacity = GlobalOpacity

		applyGlobalOpacity()
		saveConfig()
	end

	function Window:GetOpacity()
		return GlobalOpacity
	end

	function Window:SetScreenPadding(Value)
		ScreenPadding = clamp(
			math.floor((tonumber(Value) or 0) + 0.5),
			0,
			100
		)

		Config.ScreenPadding = ScreenPadding

		if IsFullscreen then
			Main.AnchorPoint = Vector2.new(0, 0)
			Main.Position = UDim2.fromOffset(
				ScreenPadding,
				ScreenPadding
			)

			Main.Size = UDim2.new(
				1,
				-(ScreenPadding * 2),
				1,
				-(ScreenPadding * 2)
			)
		end

		saveConfig()
	end

	function Window:SetFullscreen(Enabled)
		Enabled = Enabled == true

		if Enabled == IsFullscreen then
			return
		end

		IsFullscreen = Enabled
		Config.Fullscreen = IsFullscreen

		if IsFullscreen then
			LastPosition = Main.Position
			LastSize = Main.Size

			Main.AnchorPoint = Vector2.new(0, 0)
			Main.Position = UDim2.fromOffset(
				ScreenPadding,
				ScreenPadding
			)

			Main.Size = UDim2.new(
				1,
				-(ScreenPadding * 2),
				1,
				-(ScreenPadding * 2)
			)

			ResizePad.Visible = false
		else
			Main.AnchorPoint = Vector2.new(0.5, 0.5)
			Main.Position = LastPosition
			Main.Size = LastSize

			ResizePad.Visible = true
		end

		saveConfig()
	end

	function Window:IsFullscreen()
		return IsFullscreen
	end

	function Window:Minimize()
		if not WindowOpen or Destroyed then
			return
		end

		WindowOpen = false

		local Closing = Tween(Main, TweenPresets.Close, {
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1,
		})

		Closing.Completed:Once(function()
			if not Destroyed and ScreenGui.Parent then
				Main.Visible = false
				OpenButton.Visible = true
			end
		end)
	end

	function Window:Restore()
		if WindowOpen or Destroyed then
			return
		end

		WindowOpen = true
		OpenButton.Visible = false
		Main.Visible = true

		if IsFullscreen then
			Main.AnchorPoint = Vector2.new(0, 0)
			Main.Position = UDim2.fromOffset(
				ScreenPadding,
				ScreenPadding
			)

			Main.Size = UDim2.new(
				1,
				-(ScreenPadding * 2),
				1,
				-(ScreenPadding * 2)
			)
		else
			Main.Size = UDim2.fromOffset(0, 0)

			Tween(Main, TweenPresets.Open, {
				Size = LastSize,
			})
		end

		applyGlobalOpacity()
	end

	function Window:Destroy()
		if Destroyed then
			return
		end

		Destroyed = true
		WindowOpen = false

		saveConfig()

		if Goopy.Windows[ConfigName] == Window then
			Goopy.Windows[ConfigName] = nil
		end

		if ScreenGui then
			ScreenGui:Destroy()
		end
	end

	-- Tabs
	local function selectTab(Tab)
		if Destroyed or not Tab then
			return
		end

		Window.SelectedTab = Tab

		for _, OtherTab in ipairs(Window.Tabs) do
			OtherTab.Page.Visible = OtherTab == Tab

			Tween(OtherTab.Button, TweenPresets.Page, {
				BackgroundColor3 = (
					OtherTab == Tab
					and Theme.Accent
					or Theme.Tab
				),
			})
		end

		PageTitle.Text = Tab.Name
		PageSubtitle.Text = Tab.Subtitle
	end

	function Window:SelectTab(TabOrName)
		if type(TabOrName) == "string" then
			for _, Tab in ipairs(self.Tabs) do
				if Tab.Name == TabOrName then
					selectTab(Tab)
					return Tab
				end
			end

			return nil
		end

		if type(TabOrName) == "table" then
			selectTab(TabOrName)
			return TabOrName
		end

		return nil
	end

	function Window:GetTab(Name)
		for _, Tab in ipairs(self.Tabs) do
			if Tab.Name == Name then
				return Tab
			end
		end

		return nil
	end

	function Window:AddTab(TabOptions)
		TabOptions = TabOptions or {}

		local TabName = tostring(
			TabOptions.Name or ("Tab " .. tostring(#Window.Tabs + 1))
		)

		local TabIcon = tostring(TabOptions.Icon or "▣")
		local TabSubtitle = tostring(TabOptions.Subtitle or "section")

		local Button = New("TextButton", {
			Name = TabName .. "Tab",
			Size = UDim2.new(1, 0, 0, 43),

			BackgroundColor3 = Theme.Tab,
			BorderSizePixel = 0,

			AutoButtonColor = false,
			Text = "",
		}, TabScroll)

		AddCorner(Button, 10)

		bindTheme(Button, "BackgroundColor3", "Tab")
		bindOpacity(Button, "BackgroundTransparency", 0)

		local IconLabel = New("TextLabel", {
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.fromOffset(26, 43),

			BackgroundTransparency = 1,
			Text = TabIcon,
			TextColor3 = Theme.Text,
			TextSize = 16,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Center,
		}, Button)

		local TabText = New("TextLabel", {
			Position = UDim2.fromOffset(40, 6),
			Size = UDim2.new(1, -47, 0, 16),

			BackgroundTransparency = 1,
			Text = TabName,
			TextColor3 = Theme.Text,
			TextSize = 12,
			Font = Enum.Font.GothamSemibold,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, Button)

		local TabSubText = New("TextLabel", {
			Position = UDim2.fromOffset(41, 22),
			Size = UDim2.new(1, -48, 0, 13),

			BackgroundTransparency = 1,
			Text = TabSubtitle,
			TextColor3 = Theme.SubText,
			TextSize = 9,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, Button)

		bindTheme(IconLabel, "TextColor3", "Text")
		bindTheme(TabText, "TextColor3", "Text")

		local Page = New("ScrollingFrame", {
			Name = TabName .. "Page",
			Size = UDim2.fromScale(1, 1),

			BackgroundTransparency = 1,
			BorderSizePixel = 0,

			Visible = false,

			CanvasSize = UDim2.fromOffset(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,

			ScrollBarThickness = 4,
			ScrollBarImageColor3 = Theme.Accent,
			ScrollBarImageTransparency = 0.30,
		}, Pages)

		New("UIListLayout", {
			Padding = UDim.new(0, 12),
			FillDirection = Enum.FillDirection.Vertical,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Top,
		}, Page)

		New("UIPadding", {
			PaddingBottom = UDim.new(0, 12),
		}, Page)

		local Tab = {
			Name = TabName,
			Icon = TabIcon,
			Subtitle = TabSubtitle,

			Button = Button,
			Page = Page,
			Window = Window,
		}

		function Tab:AddLabel(Text, Description)
			local Height = Description and 67 or 45
			local Card = createCard(Page, Height)

			local Title = New("TextLabel", {
				Position = UDim2.fromOffset(16, 12),
				Size = UDim2.new(1, -32, 0, 20),

				BackgroundTransparency = 1,
				Text = tostring(Text or "Label"),
				TextColor3 = Theme.Text,
				TextSize = 14,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			bindTheme(Title, "TextColor3", "Text")

			if Description then
				New("TextLabel", {
					Position = UDim2.fromOffset(16, 35),
					Size = UDim2.new(1, -32, 0, 18),

					BackgroundTransparency = 1,
					Text = tostring(Description),
					TextColor3 = Theme.SubText,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, Card)
			end

			return Card
		end

		function Tab:AddButton(ButtonOptions)
			ButtonOptions = ButtonOptions or {}

			local Name = tostring(ButtonOptions.Name or "Button")
			local Description = ButtonOptions.Description
			local Callback = ButtonOptions.Callback

			local Card = createCard(Page, Description and 78 or 58)

			local Title = New("TextLabel", {
				Position = UDim2.fromOffset(16, 12),
				Size = UDim2.new(1, -140, 0, 20),

				BackgroundTransparency = 1,
				Text = Name,
				TextColor3 = Theme.Text,
				TextSize = 14,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			bindTheme(Title, "TextColor3", "Text")

			if Description then
				New("TextLabel", {
					Position = UDim2.fromOffset(16, 36),
					Size = UDim2.new(1, -140, 0, 18),

					BackgroundTransparency = 1,
					Text = tostring(Description),
					TextColor3 = Theme.SubText,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, Card)
			end

			local ActionButton = createActionButton(
				Card,
				ButtonOptions.ButtonText or "Run",
				UDim2.new(1, -98, 0.5, -18),
				UDim2.fromOffset(82, 36),
				Theme.Accent,
				"Accent"
			)

			ActionButton.MouseButton1Click:Connect(function()
				safeCallback(Callback)
			end)

			return {
				Frame = Card,
				Button = ActionButton,
			}
		end

		function Tab:AddToggle(ToggleOptions)
			ToggleOptions = ToggleOptions or {}

			local Name = tostring(ToggleOptions.Name or "Toggle")
			local Description = ToggleOptions.Description
			local Callback = ToggleOptions.Callback

			local Default = ToggleOptions.Default == true
			local Saved = Window:_LoadControl(Tab, Name, Default)

			local Value = Saved == true

			local Card = createCard(Page, Description and 78 or 58)

			local Title = New("TextLabel", {
				Position = UDim2.fromOffset(16, 12),
				Size = UDim2.new(1, -96, 0, 20),

				BackgroundTransparency = 1,
				Text = Name,
				TextColor3 = Theme.Text,
				TextSize = 14,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			bindTheme(Title, "TextColor3", "Text")

			if Description then
				New("TextLabel", {
					Position = UDim2.fromOffset(16, 36),
					Size = UDim2.new(1, -96, 0, 18),

					BackgroundTransparency = 1,
					Text = tostring(Description),
					TextColor3 = Theme.SubText,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, Card)
			end

			local ToggleButton = New("TextButton", {
				Name = "ToggleButton",

				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -16, 0.5, 0),
				Size = UDim2.fromOffset(48, 25),

				BackgroundColor3 = Theme.Tab,
				BorderSizePixel = 0,

				AutoButtonColor = false,
				Text = "",
			}, Card)

			AddCorner(ToggleButton, 20)
			bindOpacity(ToggleButton, "BackgroundTransparency", 0)

			local Knob = New("Frame", {
				Name = "Knob",

				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 3, 0.5, 0),
				Size = UDim2.fromOffset(19, 19),

				BackgroundColor3 = Theme.White,
				BorderSizePixel = 0,
			}, ToggleButton)

			AddCorner(Knob, 100)

			local function setValue(NewValue, FireCallback)
				Value = NewValue == true

				Tween(ToggleButton, TweenPresets.Hover, {
					BackgroundColor3 = (
						Value and Theme.Accent or Theme.Tab
					),
				})

				Tween(Knob, TweenPresets.Hover, {
					Position = (
						Value
						and UDim2.new(1, -22, 0.5, 0)
						or UDim2.new(0, 3, 0.5, 0)
					),
				})

				Window:_SaveControl(Tab, Name, Value)

				if FireCallback then
					safeCallback(Callback, Value)
				end
			end

			ToggleButton.MouseButton1Click:Connect(function()
				setValue(not Value, true)
			end)

			setValue(Value, false)

			return {
				Frame = Card,

				GetValue = function()
					return Value
				end,

				SetValue = function(_, NewValue)
					setValue(NewValue, true)
				end,
			}
		end

		function Tab:AddSlider(SliderOptions)
			SliderOptions = SliderOptions or {}

			local Name = tostring(SliderOptions.Name or "Slider")
			local Description = SliderOptions.Description
			local Minimum = tonumber(SliderOptions.Min) or 0
			local Maximum = tonumber(SliderOptions.Max) or 100
			local Step = tonumber(SliderOptions.Step) or 1
			local Suffix = tostring(SliderOptions.Suffix or "")
			local Callback = SliderOptions.Callback

			if Maximum < Minimum then
				Minimum, Maximum = Maximum, Minimum
			end

			if Step <= 0 then
				Step = 1
			end

			local Default = clamp(
				tonumber(SliderOptions.Default) or Minimum,
				Minimum,
				Maximum
			)

			local Saved = Window:_LoadControl(Tab, Name, Default)
			local Value = clamp(
				tonumber(Saved) or Default,
				Minimum,
				Maximum
			)

			local Card = createCard(Page, Description and 107 or 85)

			local Title = New("TextLabel", {
				Position = UDim2.fromOffset(16, 12),
				Size = UDim2.new(1, -94, 0, 20),

				BackgroundTransparency = 1,
				Text = Name,
				TextColor3 = Theme.Text,
				TextSize = 14,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			bindTheme(Title, "TextColor3", "Text")

			local ValueBox = New("TextBox", {
				Position = UDim2.new(1, -68, 0, 10),
				Size = UDim2.fromOffset(52, 25),

				BackgroundColor3 = Theme.Tab,
				BorderSizePixel = 0,

				ClearTextOnFocus = false,
				Text = "",
				TextColor3 = Theme.Text,
				TextSize = 11,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Center,
			}, Card)

			AddCorner(ValueBox, 8)

			bindTheme(ValueBox, "BackgroundColor3", "Tab")
			bindTheme(ValueBox, "TextColor3", "Text")
			bindOpacity(ValueBox, "BackgroundTransparency", 0)

			if Description then
				New("TextLabel", {
					Position = UDim2.fromOffset(16, 36),
					Size = UDim2.new(1, -32, 0, 17),

					BackgroundTransparency = 1,
					Text = tostring(Description),
					TextColor3 = Theme.SubText,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, Card)
			end

			local TrackY = Description and 73 or 55

			local Track = New("Frame", {
				Position = UDim2.fromOffset(16, TrackY),
				Size = UDim2.new(1, -32, 0, 7),

				BackgroundColor3 = Theme.Background,
				BorderSizePixel = 0,
			}, Card)

			AddCorner(Track, 10)

			bindTheme(Track, "BackgroundColor3", "Background")
			bindOpacity(Track, "BackgroundTransparency", 0)

			local Fill = New("Frame", {
				Size = UDim2.fromScale(0, 1),

				BackgroundColor3 = Theme.Accent,
				BorderSizePixel = 0,
			}, Track)

			AddCorner(Fill, 10)

			bindTheme(Fill, "BackgroundColor3", "Accent")
			bindOpacity(Fill, "BackgroundTransparency", 0)

			local Knob = New("TextButton", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),

				BackgroundColor3 = Theme.White,
				BorderSizePixel = 0,

				AutoButtonColor = false,
				Text = "",
			}, Track)

			AddCorner(Knob, 100)
			bindOpacity(Knob, "BackgroundTransparency", 0)

			local Sliding = false

			local function roundToStep(Number)
				local Steps = math.floor(
					((Number - Minimum) / Step) + 0.5
				)

				return clamp(
					Minimum + (Steps * Step),
					Minimum,
					Maximum
				)
			end

			local function setValue(NewValue, FireCallback)
				NewValue = roundToStep(tonumber(NewValue) or Minimum)
				Value = NewValue

				local Alpha = 0

				if Maximum ~= Minimum then
					Alpha = (Value - Minimum) / (Maximum - Minimum)
				end

				Fill.Size = UDim2.fromScale(Alpha, 1)
				Knob.Position = UDim2.new(Alpha, 0, 0.5, 0)

				ValueBox.Text = tostring(Value) .. Suffix

				Window:_SaveControl(Tab, Name, Value)

				if FireCallback then
					safeCallback(Callback, Value)
				end
			end

			local function setFromMouse(MouseX)
				local TrackPosition = Track.AbsolutePosition
				local TrackSize = Track.AbsoluteSize

				if TrackSize.X <= 0 then
					return
				end

				local Alpha = clamp(
					(MouseX - TrackPosition.X) / TrackSize.X,
					0,
					1
				)

				setValue(
					Minimum + ((Maximum - Minimum) * Alpha),
					true
				)
			end

			Track.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1
					or Input.UserInputType == Enum.UserInputType.Touch then

					Sliding = true
					setFromMouse(Input.Position.X)
				end
			end)

			Knob.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1
					or Input.UserInputType == Enum.UserInputType.Touch then

					Sliding = true
				end
			end)

			UserInputService.InputChanged:Connect(function(Input)
				if not Sliding then
					return
				end

				if Input.UserInputType == Enum.UserInputType.MouseMovement
					or Input.UserInputType == Enum.UserInputType.Touch then

					setFromMouse(Input.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1
					or Input.UserInputType == Enum.UserInputType.Touch then

					Sliding = false
				end
			end)

			ValueBox.FocusLost:Connect(function()
				local Text = ValueBox.Text:gsub(Suffix, "")
				setValue(tonumber(Text) or Value, true)
			end)

			setValue(Value, false)

			return {
				Frame = Card,

				GetValue = function()
					return Value
				end,

				SetValue = function(_, NewValue)
					setValue(NewValue, true)
				end,
			}
		end

		function Tab:AddTextbox(TextboxOptions)
			TextboxOptions = TextboxOptions or {}

			local Name = tostring(TextboxOptions.Name or "Textbox")
			local Description = TextboxOptions.Description
			local Placeholder = tostring(
				TextboxOptions.Placeholder or "Enter text..."
			)
			local Callback = TextboxOptions.Callback

			local Default = tostring(TextboxOptions.Default or "")
			local Saved = Window:_LoadControl(Tab, Name, Default)
			local Value = tostring(Saved or Default)

			local Card = createCard(Page, Description and 86 or 65)

			local Title = New("TextLabel", {
				Position = UDim2.fromOffset(16, 12),
				Size = UDim2.new(1, -32, 0, 20),

				BackgroundTransparency = 1,
				Text = Name,
				TextColor3 = Theme.Text,
				TextSize = 14,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			bindTheme(Title, "TextColor3", "Text")

			if Description then
				New("TextLabel", {
					Position = UDim2.fromOffset(16, 35),
					Size = UDim2.new(1, -32, 0, 16),

					BackgroundTransparency = 1,
					Text = tostring(Description),
					TextColor3 = Theme.SubText,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, Card)
			end

			local InputY = Description and 56 or 33

			local Input = New("TextBox", {
				Position = UDim2.fromOffset(16, InputY),
				Size = UDim2.new(1, -32, 0, 27),

				BackgroundColor3 = Theme.Tab,
				BorderSizePixel = 0,

				ClearTextOnFocus = false,
				Text = Value,
				TextColor3 = Theme.Text,
				TextSize = 11,
				Font = Enum.Font.Gotham,

				PlaceholderText = Placeholder,
				PlaceholderColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			AddCorner(Input, 8)

			bindTheme(Input, "BackgroundColor3", "Tab")
			bindTheme(Input, "TextColor3", "Text")
			bindOpacity(Input, "BackgroundTransparency", 0)

			New("UIPadding", {
				PaddingLeft = UDim.new(0, 9),
				PaddingRight = UDim.new(0, 9),
			}, Input)

			local function setValue(NewValue, FireCallback)
				Value = tostring(NewValue or "")
				Input.Text = Value

				Window:_SaveControl(Tab, Name, Value)

				if FireCallback then
					safeCallback(Callback, Value)
				end
			end

			Input.FocusLost:Connect(function()
				setValue(Input.Text, true)
			end)

			return {
				Frame = Card,

				GetValue = function()
					return Value
				end,

				SetValue = function(_, NewValue)
					setValue(NewValue, true)
				end,
			}
		end

		function Tab:AddDropdown(DropdownOptions)
			DropdownOptions = DropdownOptions or {}

			local Name = tostring(DropdownOptions.Name or "Dropdown")
			local Description = DropdownOptions.Description
			local Options = DropdownOptions.Options or {}
			local Callback = DropdownOptions.Callback

			local Default = DropdownOptions.Default

			if Default == nil then
				Default = Options[1]
			end

			local Saved = Window:_LoadControl(Tab, Name, Default)
			local Value = Saved

			local BaseHeight = Description and 86 or 65
			local OpenHeight = BaseHeight

			local Card = createCard(Page, BaseHeight)
			Card.ClipsDescendants = true

			local Title = New("TextLabel", {
				Position = UDim2.fromOffset(16, 12),
				Size = UDim2.new(1, -32, 0, 20),

				BackgroundTransparency = 1,
				Text = Name,
				TextColor3 = Theme.Text,
				TextSize = 14,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			bindTheme(Title, "TextColor3", "Text")

			if Description then
				New("TextLabel", {
					Position = UDim2.fromOffset(16, 35),
					Size = UDim2.new(1, -32, 0, 16),

					BackgroundTransparency = 1,
					Text = tostring(Description),
					TextColor3 = Theme.SubText,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, Card)
			end

			local ButtonY = Description and 56 or 33

			local SelectButton = New("TextButton", {
				Position = UDim2.fromOffset(16, ButtonY),
				Size = UDim2.new(1, -32, 0, 28),

				BackgroundColor3 = Theme.Tab,
				BorderSizePixel = 0,

				AutoButtonColor = false,
				Text = "",
			}, Card)

			AddCorner(SelectButton, 8)

			bindTheme(SelectButton, "BackgroundColor3", "Tab")
			bindOpacity(SelectButton, "BackgroundTransparency", 0)

			local SelectedText = New("TextLabel", {
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -34, 1, 0),

				BackgroundTransparency = 1,
				Text = tostring(Value or "Select..."),
				TextColor3 = Theme.Text,
				TextSize = 11,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, SelectButton)

			local Arrow = New("TextLabel", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -9, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),

				BackgroundTransparency = 1,
				Text = "⌄",
				TextColor3 = Theme.Text,
				TextSize = 15,
				Font = Enum.Font.GothamBold,
			}, SelectButton)

			bindTheme(SelectedText, "TextColor3", "Text")
			bindTheme(Arrow, "TextColor3", "Text")

			local OptionsHolder = New("Frame", {
				Position = UDim2.fromOffset(16, ButtonY + 34),
				Size = UDim2.new(1, -32, 0, 0),

				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ClipsDescendants = true,
			}, Card)

			local OptionsLayout = New("UIListLayout", {
				Padding = UDim.new(0, 6),
				FillDirection = Enum.FillDirection.Vertical,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Top,
			}, OptionsHolder)

			local IsOpen = false

			local function setValue(NewValue, FireCallback)
				Value = NewValue
				SelectedText.Text = tostring(Value or "Select...")

				Window:_SaveControl(Tab, Name, Value)

				if FireCallback then
					safeCallback(Callback, Value)
				end
			end

			local function rebuildOptions()
				for _, Child in ipairs(OptionsHolder:GetChildren()) do
					if Child:IsA("TextButton") then
						Child:Destroy()
					end
				end

				for _, Option in ipairs(Options) do
					local OptionText = tostring(Option)

					local OptionButton = New("TextButton", {
						Size = UDim2.new(1, 0, 0, 27),

						BackgroundColor3 = Theme.Background,
						BorderSizePixel = 0,

						AutoButtonColor = false,
						Text = OptionText,
						TextColor3 = Theme.Text,
						TextSize = 11,
						Font = Enum.Font.Gotham,
					}, OptionsHolder)

					AddCorner(OptionButton, 7)

					bindTheme(
						OptionButton,
						"BackgroundColor3",
						"Background"
					)

					bindTheme(OptionButton, "TextColor3", "Text")
					bindOpacity(
						OptionButton,
						"BackgroundTransparency",
						0
					)

					OptionButton.MouseButton1Click:Connect(function()
						setValue(Option, true)

						IsOpen = false
						Arrow.Text = "⌄"

						Tween(Card, TweenPresets.Page, {
							Size = UDim2.new(1, 0, 0, BaseHeight),
						})
					end)
				end
			end

			local function setOpen(NewOpen)
				IsOpen = NewOpen

				if IsOpen then
					rebuildOptions()

					task.defer(function()
						local ContentHeight =
							OptionsLayout.AbsoluteContentSize.Y

						OpenHeight = BaseHeight + 8 + ContentHeight

						Tween(Card, TweenPresets.Page, {
							Size = UDim2.new(
								1,
								0,
								0,
								OpenHeight
							),
						})
					end)

					Arrow.Text = "⌃"
				else
					Arrow.Text = "⌄"

					Tween(Card, TweenPresets.Page, {
						Size = UDim2.new(1, 0, 0, BaseHeight),
					})
				end
			end

			SelectButton.MouseButton1Click:Connect(function()
				setOpen(not IsOpen)
			end)

			setValue(Value, false)

			return {
				Frame = Card,

				GetValue = function()
					return Value
				end,

				SetValue = function(_, NewValue)
					setValue(NewValue, true)
				end,

				SetOptions = function(_, NewOptions)
					Options = NewOptions or {}

					if IsOpen then
						rebuildOptions()
					end
				end,
			}
		end

		function Tab:AddColorPicker(ColorOptions)
			ColorOptions = ColorOptions or {}

			local Name = tostring(
				ColorOptions.Name or "Colour picker"
			)

			local Description = ColorOptions.Description
			local Callback = ColorOptions.Callback

			local DefaultColor = ColorOptions.Default
				or Color3.fromRGB(255, 255, 255)

			local DefaultAlpha = clamp(
				tonumber(ColorOptions.Alpha) or 1,
				0,
				1
			)

			local DefaultStorage = {
				Color = colorToTable(DefaultColor),
				Alpha = DefaultAlpha,
			}

			local Saved = Window:_LoadControl(
				Tab,
				Name,
				DefaultStorage
			)

			local CurrentColor = DefaultColor
			local CurrentAlpha = DefaultAlpha

			if type(Saved) == "table" then
				CurrentColor = tableToColor(
					Saved.Color,
					DefaultColor
				)

				CurrentAlpha = clamp(
					tonumber(Saved.Alpha) or DefaultAlpha,
					0,
					1
				)
			end

			local Card = createCard(Page, Description and 78 or 58)

			local Title = New("TextLabel", {
				Position = UDim2.fromOffset(16, 12),
				Size = UDim2.new(1, -96, 0, 20),

				BackgroundTransparency = 1,
				Text = Name,
				TextColor3 = Theme.Text,
				TextSize = 14,
				Font = Enum.Font.GothamSemibold,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Card)

			bindTheme(Title, "TextColor3", "Text")

			if Description then
				New("TextLabel", {
					Position = UDim2.fromOffset(16, 36),
					Size = UDim2.new(1, -96, 0, 18),

					BackgroundTransparency = 1,
					Text = tostring(Description),
					TextColor3 = Theme.SubText,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, Card)
			end

			local Swatch = New("Frame", {
				Position = UDim2.new(1, -81, 0.5, -15),
				Size = UDim2.fromOffset(30, 30),

				BackgroundColor3 = CurrentColor,
				BackgroundTransparency = 1 - CurrentAlpha,
				BorderSizePixel = 0,
			}, Card)

			AddCorner(Swatch, 9)
			AddStroke(Swatch, Theme.White, 1, 0.70)
			bindOpacity(Swatch, "BackgroundTransparency", 0)

			local Eyedropper = New("TextButton", {
				Name = "Eyedropper",

				Position = UDim2.new(1, -43, 0.5, -15),
				Size = UDim2.fromOffset(30, 30),

				BackgroundColor3 = Theme.Tab,
				BorderSizePixel = 0,

				AutoButtonColor = false,
				Text = "⌁",
				TextColor3 = Theme.Text,
				TextSize = 18,
				Font = Enum.Font.GothamBold,
			}, Card)

			AddCorner(Eyedropper, 9)

			bindTheme(Eyedropper, "BackgroundColor3", "Tab")
			bindTheme(Eyedropper, "TextColor3", "Text")
			bindOpacity(Eyedropper, "BackgroundTransparency", 0)

			local function setValue(NewColor, NewAlpha, FireCallback)
				if typeof(NewColor) == "Color3" then
					CurrentColor = NewColor
				end

				CurrentAlpha = clamp(
					tonumber(NewAlpha) or CurrentAlpha,
					0,
					1
				)

				Swatch.BackgroundColor3 = CurrentColor
				Swatch.BackgroundTransparency = 1 - CurrentAlpha

				Window:_SaveControl(Tab, Name, {
					Color = colorToTable(CurrentColor),
					Alpha = CurrentAlpha,
				})

				if FireCallback then
					safeCallback(
						Callback,
						CurrentColor,
						CurrentAlpha
					)
				end
			end

			Eyedropper.MouseButton1Click:Connect(function()
				openColorPicker(
					Name,
					CurrentColor,
					CurrentAlpha,
					function(NewColor, NewAlpha)
						setValue(NewColor, NewAlpha, true)
					end
				)
			end)

			setValue(CurrentColor, CurrentAlpha, false)

			return {
				Frame = Card,

				GetValue = function()
					return CurrentColor, CurrentAlpha
				end,

				SetValue = function(_, NewColor, NewAlpha)
					setValue(NewColor, NewAlpha, true)
				end,
			}
		end

		Button.MouseButton1Click:Connect(function()
			selectTab(Tab)
		end)

		table.insert(Window.Tabs, Tab)

		if #Window.Tabs == 1 then
			selectTab(Tab)
		end

		return Tab
	end

	function Window:AddTabs(TabOptionsList)
		local Wrapper = {
			Tabs = {},
		}

		for _, TabOptions in ipairs(TabOptionsList or {}) do
			table.insert(
				Wrapper.Tabs,
				Window:AddTab(TabOptions)
			)
		end

		function Wrapper:GetTab(Index)
			return self.Tabs[Index]
		end

		return Wrapper
	end

	-- Window controls
	local function saveWindowState()
		if Destroyed then
			return
		end

		Config.Fullscreen = IsFullscreen
		Config.ScreenPadding = ScreenPadding
		Config.Opacity = GlobalOpacity

		if not IsFullscreen then
			Config.Position.XScale = Main.Position.X.Scale
			Config.Position.XOffset = Main.Position.X.Offset
			Config.Position.YScale = Main.Position.Y.Scale
			Config.Position.YOffset = Main.Position.Y.Offset

			Config.Size.Width = Main.AbsoluteSize.X
			Config.Size.Height = Main.AbsoluteSize.Y
		end

		saveConfig()
	end

	local Dragging = false
	local DragStart
	local DragOrigin

	DragStrip.InputBegan:Connect(function(Input)
		if Destroyed or PickerOpen or IsFullscreen then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.MouseButton1
			and Input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		Dragging = true
		DragStart = Input.Position
		DragOrigin = Main.Position
	end)

	local Resizing = false
	local ResizeStartMouse
	local ResizeStartSize

	ResizePad.InputBegan:Connect(function(Input)
		if Destroyed or PickerOpen or IsFullscreen then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.MouseButton1
			and Input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		Resizing = true
		ResizeStartMouse = Input.Position
		ResizeStartSize = Main.AbsoluteSize
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if Destroyed then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.MouseMovement
			and Input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		-- The colour picker consumes drag movement when open.
		if PickerOpen then
			if PickingSaturationValue then
				setSaturationValue(Input.Position)
			end

			if PickingHue then
				setHue(Input.Position)
			end

			if PickingAlpha then
				setAlpha(Input.Position)
			end

			return
		end

		if Dragging then
			local Delta = Input.Position - DragStart

			Main.Position = UDim2.new(
				DragOrigin.X.Scale,
				DragOrigin.X.Offset + Delta.X,
				DragOrigin.Y.Scale,
				DragOrigin.Y.Offset + Delta.Y
			)

			LastPosition = Main.Position
		end

		if Resizing then
			local Delta = Input.Position - ResizeStartMouse

			local NewWidth = clamp(
				ResizeStartSize.X + Delta.X,
				440,
				1200
			)

			local NewHeight = clamp(
				ResizeStartSize.Y + Delta.Y,
				330,
				900
			)

			Main.Size = UDim2.fromOffset(
				NewWidth,
				NewHeight
			)

			LastSize = Main.Size
		end
	end)

	UserInputService.InputEnded:Connect(function(Input)
		if Destroyed then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.MouseButton1
			and Input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		if PickerOpen then
			PickingSaturationValue = false
			PickingHue = false
			PickingAlpha = false
			return
		end

		local ChangedWindow = Dragging or Resizing

		Dragging = false
		Resizing = false

		if ChangedWindow then
			saveWindowState()
		end
	end)

	MinimizeButton.MouseButton1Click:Connect(function()
		Window:Minimize()
	end)

	OpenButton.MouseButton1Click:Connect(function()
		Window:Restore()
	end)

	OpenButton.MouseEnter:Connect(function()
		Tween(OpenButton, TweenPresets.Hover, {
			BackgroundColor3 = Theme.Accent,
		})
	end)

	OpenButton.MouseLeave:Connect(function()
		Tween(OpenButton, TweenPresets.Hover, {
			BackgroundColor3 = Theme.Card,
		})
	end)

	MinimizeButton.MouseEnter:Connect(function()
		Tween(MinimizeButton, TweenPresets.Hover, {
			BackgroundColor3 = Theme.Accent,
		})
	end)

	MinimizeButton.MouseLeave:Connect(function()
		Tween(MinimizeButton, TweenPresets.Hover, {
			BackgroundColor3 = Theme.Tab,
		})
	end)

	ResizePad.MouseEnter:Connect(function()
		if not IsFullscreen then
			Tween(ResizePad, TweenPresets.Hover, {
				BackgroundColor3 = Theme.Accent,
			})
		end
	end)

	ResizePad.MouseLeave:Connect(function()
		Tween(ResizePad, TweenPresets.Hover, {
			BackgroundColor3 = Theme.Tab,
		})
	end)

	-- Initial visual setup
	Window:SetOpacity(GlobalOpacity)

	if IsFullscreen then
		ResizePad.Visible = false

		task.defer(function()
			if Destroyed then
				return
			end

			Main.AnchorPoint = Vector2.new(0, 0)
			Main.Position = UDim2.fromOffset(
				ScreenPadding,
				ScreenPadding
			)

			Main.Size = UDim2.new(
				1,
				-(ScreenPadding * 2),
				1,
				-(ScreenPadding * 2)
			)

			applyGlobalOpacity()
		end)
	else
		task.defer(function()
			if Destroyed then
				return
			end

			Tween(Main, TweenPresets.Open, {
				Size = LastSize,
			})

			applyGlobalOpacity()
		end)
	end

	Goopy.Windows[ConfigName] = Window

	return Window
end

--[[
	Goopy:CreateDefaultTemplate(Window, Options)

	Builds the "Main / Settings / Changelog" starter template (status card,
	test control, destroy button, per-theme colour rows, opacity slider,
	fullscreen toggle, edge-padding slider, and a changelog page) on top of
	an existing Window, using the library's own tab API so everything stays
	theme-reactive and config-saving like any other control.

	Usage:
		local Window = Goopy:CreateWindow({ Name = "Goopy" })
		Goopy:CreateDefaultTemplate(Window)

	Options (all optional):
		ChangelogText   = string, overrides the default changelog body
		OnTest          = function(), called when "Test" is clicked
		OnDestroy       = function(), called right before Window:Destroy()
		IncludeTabs     = { Main = true, Settings = true, Changelog = true }
			set any of these to false to skip that tab
]]
function Goopy:CreateDefaultTemplate(Window, Options)
	Options = Options or {}

	local IncludeTabs = Options.IncludeTabs or {}
	local WantMain = IncludeTabs.Main ~= false
	local WantSettings = IncludeTabs.Settings ~= false
	local WantChangelog = IncludeTabs.Changelog ~= false

	local Template = {}

	--// Main tab: status card, test control, destroy control
	if WantMain then
		local MainTab = Window:AddTab({
			Name = "Main",
			Icon = "▣",
			Subtitle = "overview",
		})

		local StatusControl = MainTab:AddLabel(
			"GUI loaded successfully",
			"Drag from the slim sidebar strip, resize from the bottom-right corner, and use Settings to edit the interface."
		)

		local TestControl = MainTab:AddButton({
			Name = "Test control",
			Description = "A placeholder interaction.",
			ButtonText = "Test",

			Callback = function()
				safeCallback(Options.OnTest)
			end,
		})

		MainTab:AddButton({
			Name = "Interface controls",
			Description = "Remove this interface completely.",
			ButtonText = "Destroy GUI",

			Callback = function()
				safeCallback(Options.OnDestroy)
				Window:Destroy()
			end,
		})

		Template.MainTab = MainTab
		Template.StatusControl = StatusControl
		Template.TestControl = TestControl
	end

	--// Settings tab: theme colour rows, opacity, fullscreen, padding
	if WantSettings then
		local SettingsTab = Window:AddTab({
			Name = "Settings",
			Icon = "⚙",
			Subtitle = "appearance",
		})

		SettingsTab:AddLabel(
			"Appearance",
			"Each colour picker opens the HSV/alpha picker."
		)

		local ThemeRows = {
			{ Name = "GUI background", Key = "Background", Description = "Changes the main window background." },
			{ Name = "Card background", Key = "Card", Description = "Changes cards and sidebar background." },
			{ Name = "Accent colour", Key = "Accent", Description = "Changes active tabs and highlights." },
			{ Name = "Tab button colour", Key = "Tab", Description = "Changes inactive tab/control backgrounds." },
			{ Name = "Primary text colour", Key = "Text", Description = "Changes headings, icons, and buttons." },
		}

		local ColourControls = {}

		for _, Row in ipairs(ThemeRows) do
			ColourControls[Row.Key] = SettingsTab:AddColorPicker({
				Name = Row.Name,
				Description = Row.Description,
				Default = Window.Theme[Row.Key],
				Alpha = 1,

				Callback = function(NewColor)
					Window:SetTheme({ [Row.Key] = NewColor })
				end,
			})
		end

		local OpacityControl = SettingsTab:AddSlider({
			Name = "Entire GUI opacity",
			Description = "Fades the main window, sidebar, cards, tabs, and controls.",

			Min = 0,
			Max = 85,
			Default = math.floor(Window:GetOpacity() * 100 + 0.5),
			Suffix = "%",

			Callback = function(Value)
				Window:SetOpacity(Value / 100)
			end,
		})

		local FullscreenControl = SettingsTab:AddToggle({
			Name = "Fullscreen layout",
			Description = "Expand the window while keeping its edge padding.",
			Default = Window:IsFullscreen(),

			Callback = function(Value)
				Window:SetFullscreen(Value)
			end,
		})

		local PaddingControl = SettingsTab:AddSlider({
			Name = "Fullscreen edge padding",
			Description = "Distance between the fullscreen GUI and screen edges.",

			Min = 0,
			Max = 100,
			Default = 24,

			Callback = function(Value)
				Window:SetScreenPadding(Value)
			end,
		})

		Template.SettingsTab = SettingsTab
		Template.ColourControls = ColourControls
		Template.OpacityControl = OpacityControl
		Template.FullscreenControl = FullscreenControl
		Template.PaddingControl = PaddingControl
	end

	--// Changelog tab: a single scrollable card with wrapped body text
	if WantChangelog then
		local ChangelogTab = Window:AddTab({
			Name = "Changelog",
			Icon = "▤",
			Subtitle = "updates",
		})

		local DefaultChangelogText = [[
VERSION 1.1 — DRAG + FULL OPACITY FIX

INTERFACE
• Rounded dark card interface with smooth Quint opening.
• Main, Settings, and Changelog pages use vertical side tabs.
• Settings uses a cog icon.
• Previous UI is removed automatically when the script is rerun.

WINDOW CONTROLS
• GUI dragging is restored via the slim sidebar strip.
• Bottom-right rounded pad resizes the GUI.
• Minimize control is placed in the top-right corner.
• A plus button appears at bottom-left after minimizing.
• Destroy GUI completely removes the ScreenGui.
• Fullscreen mode and edge padding are adjustable in Settings.

COLOUR SYSTEM
• Advanced HSV colour picker replaces RGB text inputs.
• Drag inside the square to select saturation and brightness.
• Drag the rainbow bar to select hue, the alpha bar for transparency.
• Picker shows a movable handle, preview swatch, alpha percent,
  and generated hex value.

OPACITY
• The global opacity slider affects the main background, sidebar,
  cards, tabs, buttons, sliders, resize pad, and modal background.
• Text stays readable instead of fading with the backgrounds.

CONFIG
• Auto-saves to goopy/<ConfigName>.json when filesystem APIs exist.
• Saves position, size, fullscreen setting, padding, opacity,
  and configured theme colours.
]]

		local ChangelogText = tostring(
			Options.ChangelogText or DefaultChangelogText
		)

		local ChangelogCard = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,

			BackgroundColor3 = Window.Theme.Card,
			BorderSizePixel = 0,
		}, ChangelogTab.Page)

		AddCorner(ChangelogCard, 13)
		AddStroke(ChangelogCard, Window.Theme.Stroke, 1, 0.45)

		local ChangelogTitle = New("TextLabel", {
			Position = UDim2.fromOffset(18, 16),
			Size = UDim2.new(1, -36, 0, 22),

			BackgroundTransparency = 1,
			Text = "Current build — complete changelog",
			TextColor3 = Window.Theme.Text,
			TextSize = 15,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, ChangelogCard)

		local ChangelogBody = New("TextLabel", {
			Position = UDim2.fromOffset(18, 52),
			Size = UDim2.new(1, -36, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,

			BackgroundTransparency = 1,
			Text = ChangelogText,
			TextColor3 = Window.Theme.SubText,
			TextSize = 11,
			Font = Enum.Font.Gotham,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		}, ChangelogCard)

		New("UIPadding", {
			PaddingBottom = UDim.new(0, 16),
		}, ChangelogCard)

		Template.ChangelogTab = ChangelogTab
		Template.ChangelogCard = ChangelogCard
		Template.ChangelogBody = ChangelogBody
	end

	return Template
end

return Goopy
