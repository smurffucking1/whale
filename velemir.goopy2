--[[
    Goopy UI Library
    Full reusable executor-style UI library.

    Library API:
        local Goopy = loadstring(game:HttpGet("RAW_URL"))()

        local Window = Goopy:CreateWindow({
            Name = "Goopy",
            ConfigName = "MainHub",
            Size = Vector2.new(720, 475),
        })

        local Main = Window:AddTab({
            Name = "Main",
            Icon = "▣",
        })

        Main:AddLabel("Hello")
        Main:AddButton({ Name = "Click", Callback = function() end })
        Main:AddToggle({ Name = "Toggle", Default = false, Callback = function(v) end })
        Main:AddSlider({ Name = "Number", Min = 0, Max = 100, Default = 50, Callback = function(v) end })
        Main:AddTextbox({ Name = "Text", Placeholder = "Write here", Callback = function(text) end })
        Main:AddDropdown({ Name = "Mode", Options = {"One", "Two"}, Default = "One", Callback = function(v) end })
        Main:AddColorPicker({ Name = "Accent", Default = Color3.fromRGB(145, 80, 255), Alpha = 1, Callback = function(c, a) end })

    Built-in window methods:
        Window:SetTheme({ Background = Color3..., Card = Color3..., Accent = Color3..., Tab = Color3..., Text = Color3... })
        Window:SetOpacity(0.15)
        Window:SetFullscreen(true)
        Window:SetScreenPadding(24)
        Window:SelectTab(Tab)
        Window:Destroy()

    Requires filesystem functions for persistence:
        isfolder, makefolder, isfile, readfile, writefile
    If those do not exist, the library still works without config saving.
]]

local Goopy = {}

--// Services
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

--// GUI parent
local GuiParent = gethui and gethui() or CoreGui

--// Library window registry
Goopy.Windows = {}

--// Config settings
local ConfigFolder = "goopy"

local HasFileSystem =
	type(isfolder) == "function"
	and type(makefolder) == "function"
	and type(isfile) == "function"
	and type(readfile) == "function"
	and type(writefile) == "function"

--// Helpers
local function deepCopy(Input)
	local Output = {}

	for Key, Value in pairs(Input) do
		if type(Value) == "table" then
			Output[Key] = deepCopy(Value)
		else
			Output[Key] = Value
		end
	end

	return Output
end

local function colorToTable(Color)
	return {
		R = math.floor(Color.R * 255 + 0.5),
		G = math.floor(Color.G * 255 + 0.5),
		B = math.floor(Color.B * 255 + 0.5),
	}
end

local function tableToColor(Data, Fallback)
	if type(Data) ~= "table" then
		return Fallback
	end

	if type(Data.R) ~= "number"
		or type(Data.G) ~= "number"
		or type(Data.B) ~= "number" then
		return Fallback
	end

	return Color3.fromRGB(
		math.clamp(Data.R, 0, 255),
		math.clamp(Data.G, 0, 255),
		math.clamp(Data.B, 0, 255)
	)
end

local function New(ClassName, Properties, Parent)
	local Object = Instance.new(ClassName)

	for Property, Value in pairs(Properties) do
		Object[Property] = Value
	end

	Object.Parent = Parent

	return Object
end

local function AddCorner(Parent, Radius)
	return New("UICorner", {
		CornerRadius = UDim.new(0, Radius),
	}, Parent)
end

local function AddStroke(Parent, Color, Thickness, Transparency)
	return New("UIStroke", {
		Color = Color,
		Thickness = Thickness or 1,
		Transparency = Transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, Parent)
end

local function Tween(Object, Info, Properties)
	local Animation = TweenService:Create(Object, Info, Properties)
	Animation:Play()

	return Animation
end

local function clamp(Value, Minimum, Maximum)
	return math.max(Minimum, math.min(Maximum, Value))
end

local function safeCallback(Callback, ...)
	if type(Callback) ~= "function" then
		return
	end

	local Arguments = table.pack(...)

	task.spawn(function()
		pcall(function()
			Callback(table.unpack(Arguments, 1, Arguments.n))
		end)
	end)
end

local TweenPresets = {
	Open = TweenInfo.new(
		0.62,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	),

	Close = TweenInfo.new(
		0.28,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.In
	),

	Hover = TweenInfo.new(
		0.15,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	),

	Page = TweenInfo.new(
		0.18,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	),
}

local DefaultTheme = {
	Background = Color3.fromRGB(15, 15, 20),
	Card = Color3.fromRGB(25, 25, 33),
	Accent = Color3.fromRGB(148, 82, 255),
	Tab = Color3.fromRGB(35, 35, 45),
	Text = Color3.fromRGB(245, 243, 250),

	SubText = Color3.fromRGB(159, 155, 173),
	Stroke = Color3.fromRGB(76, 72, 92),
	White = Color3.fromRGB(255, 255, 255),
	Danger = Color3.fromRGB(216, 70, 93),
	DangerCard = Color3.fromRGB(43, 23, 31),
}

local function getDefaultConfig()
	return {
		Position = {
			XScale = 0.5,
			XOffset = 0,
			YScale = 0.5,
			YOffset = 0,
		},

		Size = {
			Width = 720,
			Height = 475,
		},

		Fullscreen = false,
		ScreenPadding = 24,
		Opacity = 0.02,

		Theme = {
			Background = colorToTable(DefaultTheme.Background),
			Card = colorToTable(DefaultTheme.Card),
			Accent = colorToTable(DefaultTheme.Accent),
			Tab = colorToTable(DefaultTheme.Tab),
			Text = colorToTable(DefaultTheme.Text),
		},

		Controls = {},
	}
end

function Goopy:DestroyAll()
	for _, Window in pairs(self.Windows) do
		if Window and Window.Destroy then
			Window:Destroy()
		end
	end

	self.Windows = {}
end

function Goopy:CreateWindow(Options)
	Options = Options or {}

	local WindowName = tostring(Options.Name or "goopy")
	local ConfigName = tostring(
		Options.ConfigName or WindowName:gsub("[^%w_%-]", "_")
	)

	local ConfigFile = ConfigFolder .. "/" .. ConfigName .. ".json"

	-- Remove only a previous window using the exact same window ID.
	local ExistingWindow = Goopy.Windows[ConfigName]
	if ExistingWindow and ExistingWindow.Destroy then
		ExistingWindow:Destroy()
	end

	local DefaultConfig = getDefaultConfig()

	if typeof(Options.Size) == "Vector2" then
		DefaultConfig.Size.Width = math.floor(Options.Size.X)
		DefaultConfig.Size.Height = math.floor(Options.Size.Y)
	end

	if type(Options.ScreenPadding) == "number" then
		DefaultConfig.ScreenPadding = Options.ScreenPadding
	end

	if type(Options.Opacity) == "number" then
		DefaultConfig.Opacity = Options.Opacity
	end

	local Config = deepCopy(DefaultConfig)

	local function loadConfig()
		if not HasFileSystem then
			return
		end

		pcall(function()
			if not isfolder(ConfigFolder) then
				makefolder(ConfigFolder)
			end

			if not isfile(ConfigFile) then
				writefile(ConfigFile, HttpService:JSONEncode(DefaultConfig))
				return
			end

			local Loaded = HttpService:JSONDecode(readfile(ConfigFile))

			if type(Loaded) ~= "table" then
				return
			end

			for Key, Value in pairs(Loaded) do
				Config[Key] = Value
			end

			Config.Position = Config.Position or deepCopy(DefaultConfig.Position)
			Config.Size = Config.Size or deepCopy(DefaultConfig.Size)
			Config.Theme = Config.Theme or {}
			Config.Controls = Config.Controls or {}

			for Key, Value in pairs(DefaultConfig.Theme) do
				if type(Config.Theme[Key]) ~= "table" then
					Config.Theme[Key] = Value
				end
			end
		end)
	end

	local function saveConfig()
		if not HasFileSystem then
			return
		end

		pcall(function()
			if not isfolder(ConfigFolder) then
				makefolder(ConfigFolder)
			end

			writefile(ConfigFile, HttpService:JSONEncode(Config))
		end)
	end

	loadConfig()

	local Theme = {
		Background = tableToColor(
			Config.Theme.Background,
			DefaultTheme.Background
		),

		Card = tableToColor(
			Config.Theme.Card,
			DefaultTheme.Card
		),

		Accent = tableToColor(
			Config.Theme.Accent,
			DefaultTheme.Accent
		),

		Tab = tableToColor(
			Config.Theme.Tab,
			DefaultTheme.Tab
		),

		Text = tableToColor(
			Config.Theme.Text,
			DefaultTheme.Text
		),

		SubText = DefaultTheme.SubText,
		Stroke = DefaultTheme.Stroke,
		White = DefaultTheme.White,
		Danger = DefaultTheme.Danger,
		DangerCard = DefaultTheme.DangerCard,
	}

	local StartWidth = clamp(
		tonumber(Config.Size.Width) or 720,
		440,
		1200
	)

	local StartHeight = clamp(
		tonumber(Config.Size.Height) or 475,
		330,
		900
	)

	local StartPosition = UDim2.new(
		tonumber(Config.Position.XScale) or 0.5,
		tonumber(Config.Position.XOffset) or 0,
		tonumber(Config.Position.YScale) or 0.5,
		tonumber(Config.Position.YOffset) or 0
	)

	local GlobalOpacity = clamp(
		tonumber(Config.Opacity) or 0.02,
		0,
		0.85
	)

	local ScreenPadding = clamp(
		tonumber(Config.ScreenPadding) or 24,
		0,
		100
	)

	local IsFullscreen = Config.Fullscreen == true
	local WindowOpen = true
	local Destroyed = false

	local LastPosition = StartPosition
	local LastSize = UDim2.fromOffset(StartWidth, StartHeight)

	-- Theme and opacity registries
	local ThemeBindings = {
		Background = {},
		Card = {},
		Accent = {},
		Tab = {},
		Text = {},
	}

	local OpacityBindings = {}

	local function bindTheme(Object, PropertyName, ThemeKey)
		if not ThemeBindings[ThemeKey] then
			return
		end

		table.insert(ThemeBindings[ThemeKey], {
			Object = Object,
			Property = PropertyName,
		})
	end

	local function bindOpacity(Object, PropertyName, BaseTransparency)
		table.insert(OpacityBindings, {
			Object = Object,
			Property = PropertyName,
			BaseTransparency = BaseTransparency or 0,
		})
	end

	local function refreshThemeKey(ThemeKey)
		local Bindings = ThemeBindings[ThemeKey]

		if not Bindings then
			return
		end

		for Index = #Bindings, 1, -1 do
			local Binding = Bindings[Index]

			if not Binding.Object or not Binding.Object.Parent then
				table.remove(Bindings, Index)
			else
				pcall(function()
					Binding.Object[Binding.Property] = Theme[ThemeKey]
				end)
			end
		end
	end

	local function applyGlobalOpacity()
		for Index = #OpacityBindings, 1, -1 do
			local Binding = OpacityBindings[Index]

			if not Binding.Object or not Binding.Object.Parent then
				table.remove(OpacityBindings, Index)
			else
				local Transparency = Binding.BaseTransparency
					+ ((1 - Binding.BaseTransparency) * GlobalOpacity)

				pcall(function()
					Binding.Object[Binding.Property] = clamp(
						Transparency,
						0,
						1
					)
				end)
			end
		end
	end

	-- ScreenGui
	local ExistingGui = GuiParent:FindFirstChild(
		"Goopy_" .. ConfigName
	)

	if ExistingGui then
		ExistingGui:Destroy()
	end

	local ScreenGui = New("ScreenGui", {
		Name = "Goopy_" .. ConfigName,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
	}, GuiParent)

	-- Main window
	local Main = New("Frame", {
		Name = "Main",

		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = StartPosition,
		Size = UDim2.fromOffset(0, 0),

		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,

		ClipsDescendants = true,
	}, ScreenGui)

	AddCorner(Main, 18)
	AddStroke(Main, Theme.Stroke, 1, 0.25)

	bindTheme(Main, "BackgroundColor3", "Background")
	bindOpacity(Main, "BackgroundTransparency", 0)

	-- Reopen button
	local OpenButton = New("TextButton", {
		Name = "OpenButton",

		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -20),
		Size = UDim2.fromOffset(48, 48),

		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,

		AutoButtonColor = false,
		Text = "+",
		TextColor3 = Theme.Text,
		TextSize = 25,
		Font = Enum.Font.GothamBold,

		Visible = false,
		ZIndex = 100,
	}, ScreenGui)

	AddCorner(OpenButton, 14)
	AddStroke(OpenButton, Theme.Stroke, 1, 0.20)

	bindTheme(OpenButton, "BackgroundColor3", "Card")
	bindTheme(OpenButton, "TextColor3", "Text")
	bindOpacity(OpenButton, "BackgroundTransparency", 0)

	-- Sidebar
	local Sidebar = New("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 142, 1, 0),

		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
	}, Main)

	AddCorner(Sidebar, 18)

	bindTheme(Sidebar, "BackgroundColor3", "Card")
	bindOpacity(Sidebar, "BackgroundTransparency", 0)

	local SidebarMask = New("Frame", {
		Name = "SidebarMask",
		Position = UDim2.new(1, -20, 0, 0),
		Size = UDim2.new(0, 20, 1, 0),

		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
	}, Sidebar)

	bindTheme(SidebarMask, "BackgroundColor3", "Card")
	bindOpacity(SidebarMask, "BackgroundTransparency", 0)

	local SidebarDivider = New("Frame", {
		Name = "SidebarDivider",
		Position = UDim2.new(1, -1, 0, 18),
		Size = UDim2.new(0, 1, 1, -36),

		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
	}, Sidebar)

	bindOpacity(SidebarDivider, "BackgroundTransparency", 0.45)

	local Brand = New("TextLabel", {
		Name = "Brand",
		Position = UDim2.fromOffset(18, 18),
		Size = UDim2.new(1, -36, 0, 25),

		BackgroundTransparency = 1,
		Text = WindowName,
		TextColor3 = Theme.Text,
		TextSize = 18,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Sidebar)

	local BrandSub = New("TextLabel", {
		Name = "BrandSub",
		Position = UDim2.fromOffset(19, 42),
		Size = UDim2.new(1, -38, 0, 16),

		BackgroundTransparency = 1,
		Text = "ui library",
		TextColor3 = Theme.SubText,
		TextSize = 10,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Sidebar)

	bindTheme(Brand, "TextColor3", "Text")

	-- This is the dedicated GUI drag target.
	local DragStrip = New("TextButton", {
		Name = "DragStrip",
		Position = UDim2.fromOffset(18, 67),
		Size = UDim2.new(1, -36, 0, 8),

		BackgroundColor3 = Theme.Tab,
		BorderSizePixel = 0,

		AutoButtonColor = false,
		Text = "",
	}, Sidebar)

	AddCorner(DragStrip, 10)

	bindTheme(DragStrip, "BackgroundColor3", "Tab")
	bindOpacity(DragStrip, "BackgroundTransparency", 0.08)

	local TabScroll = New("ScrollingFrame", {
		Name = "TabScroll",
		Position = UDim2.fromOffset(11, 91),
		Size = UDim2.new(1, -22, 1, -108),

		BackgroundTransparency = 1,
		BorderSizePixel = 0,

		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,

		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		ScrollBarImageTransparency = 0.30,
	}, Sidebar)

	New("UIListLayout", {
		Padding = UDim.new(0, 8),
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, TabScroll)

	-- Right content area
	local RightArea = New("Frame", {
		Name = "RightArea",
		Position = UDim2.new(0, 142, 0, 0),
		Size = UDim2.new(1, -142, 1, 0),

		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, Main)

	local Header = New("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 75),

		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, RightArea)

	local PageTitle = New("TextLabel", {
		Name = "PageTitle",
		Position = UDim2.fromOffset(25, 19),
		Size = UDim2.new(1, -150, 0, 24),

		BackgroundTransparency = 1,
		Text = "No tab selected",
		TextColor3 = Theme.Text,
		TextSize = 18,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Header)

	local PageSubtitle = New("TextLabel", {
		Name = "PageSubtitle",
		Position = UDim2.fromOffset(25, 43),
		Size = UDim2.new(1, -150, 0, 17),

		BackgroundTransparency = 1,
		Text = "Create a tab to begin",
		TextColor3 = Theme.SubText,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Header)

	bindTheme(PageTitle, "TextColor3", "Text")

	local MinimizeButton = New("TextButton", {
		Name = "MinimizeButton",

		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 18),
		Size = UDim2.fromOffset(34, 31),

		BackgroundColor3 = Theme.Tab,
		BorderSizePixel = 0,

		AutoButtonColor = false,
		Text = "—",
		TextColor3 = Theme.Text,
