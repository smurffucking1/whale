	AddCorner(MinimizeButton, 10)
	AddStroke(MinimizeButton, Theme.White, 1, 0.92)

	bindTheme(MinimizeButton, "BackgroundColor3", "Tab")
	bindTheme(MinimizeButton, "TextColor3", "Text")
	bindOpacity(MinimizeButton, "BackgroundTransparency", 0)

	local HeaderDivider = New("Frame", {
		Name = "HeaderDivider",
		Position = UDim2.new(0, 20, 1, -1),
		Size = UDim2.new(1, -40, 0, 1),

		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
	}, Header)

	bindOpacity(HeaderDivider, "BackgroundTransparency", 0.42)

	local Pages = New("Frame", {
		Name = "Pages",
		Position = UDim2.fromOffset(20, 91),
		Size = UDim2.new(1, -40, 1, -111),

		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, RightArea)

	-- Resize handle
	local ResizePad = New("TextButton", {
		Name = "ResizePad",

		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(25, 25),

		BackgroundColor3 = Theme.Tab,
		BorderSizePixel = 0,

		AutoButtonColor = false,
		Text = "",
		ZIndex = 60,
	}, Main)

	AddCorner(ResizePad, 8)
	AddStroke(ResizePad, Theme.Stroke, 1, 0.35)

	bindTheme(ResizePad, "BackgroundColor3", "Tab")
	bindOpacity(ResizePad, "BackgroundTransparency", 0)

	for Index = 1, 3 do
		local Line = New("Frame", {
			Name = "ResizeLine" .. Index,

			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(
				11 + (Index * 3),
				18 - (Index * 3)
			),
			Size = UDim2.fromOffset(8, 2),

			Rotation = -45,
			BackgroundColor3 = Theme.SubText,
			BorderSizePixel = 0,
			ZIndex = 61,
		}, ResizePad)

		bindOpacity(Line, "BackgroundTransparency", 0.20)
	end

	-- Reusable UI constructors
	local function createCard(Parent, Height)
		local Card = New("Frame", {
			Size = UDim2.new(1, 0, 0, Height),

			BackgroundColor3 = Theme.Card,
			BorderSizePixel = 0,
		}, Parent)

		AddCorner(Card, 13)
		AddStroke(Card, Theme.Stroke, 1, 0.45)

		bindTheme(Card, "BackgroundColor3", "Card")
		bindOpacity(Card, "BackgroundTransparency", 0)

		return Card
	end

	local function createActionButton(
		Parent,
		Text,
		Position,
		Size,
		BackgroundColor,
		ThemeKey
	)
		local Button = New("TextButton", {
			Name = Text:gsub("%s+", ""),
			Position = Position,
			Size = Size,

			BackgroundColor3 = BackgroundColor,
			BorderSizePixel = 0,

			AutoButtonColor = false,
			Text = Text,
			TextColor3 = Theme.Text,
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
		}, Parent)

		AddCorner(Button, 10)
		AddStroke(Button, Theme.White, 1, 0.92)

		bindTheme(Button, "TextColor3", "Text")
		bindOpacity(Button, "BackgroundTransparency", 0)

		if ThemeKey then
			bindTheme(Button, "BackgroundColor3", ThemeKey)
		end

		return Button
	end

	-- Advanced HSV + alpha picker
	local ColorModal = New("Frame", {
		Name = "ColorModal",

		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(380, 405),

		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,

		Visible = false,
		ZIndex = 200,
	}, ScreenGui)

	AddCorner(ColorModal, 16)
	AddStroke(ColorModal, Theme.Stroke, 1, 0.15)

	bindTheme(ColorModal, "BackgroundColor3", "Card")
	bindOpacity(ColorModal, "BackgroundTransparency", 0)

	local ModalDim = New("TextButton", {
		Name = "ModalDim",
		Size = UDim2.fromScale(1, 1),

		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BorderSizePixel = 0,

		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 190,
	}, ScreenGui)

	bindOpacity(ModalDim, "BackgroundTransparency", 0.48)

	local ModalTitle = New("TextLabel", {
		Position = UDim2.fromOffset(20, 18),
		Size = UDim2.new(1, -98, 0, 22),

		BackgroundTransparency = 1,
		Text = "Colour picker",
		TextColor3 = Theme.Text,
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 201,
	}, ColorModal)

	bindTheme(ModalTitle, "TextColor3", "Text")

	local ColorPreview = New("Frame", {
		Position = UDim2.new(1, -57, 0, 14),
		Size = UDim2.fromOffset(34, 34),

		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 201,
	}, ColorModal)

	AddCorner(ColorPreview, 10)
	AddStroke(ColorPreview, Theme.White, 1, 0.65)

	local SaturationValuePanel = New("Frame", {
		Name = "SaturationValuePanel",
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.fromOffset(220, 220),

		BackgroundColor3 = Color3.fromHSV(0, 1, 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 201,
	}, ColorModal)

	AddCorner(SaturationValuePanel, 12)
	AddStroke(SaturationValuePanel, Theme.White, 1, 0.75)

	local SaturationOverlay = New("Frame", {
		Size = UDim2.fromScale(1, 1),

		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 202,
