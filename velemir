--// Config helper
local function saveWindowConfig()
	if IsFullscreen then
		Config.Fullscreen = true
	else
		Config.Fullscreen = false

		Config.Position.XScale = Main.Position.X.Scale
		Config.Position.XOffset = Main.Position.X.Offset
		Config.Position.YScale = Main.Position.Y.Scale
		Config.Position.YOffset = Main.Position.Y.Offset

		Config.Size.Width = Main.AbsoluteSize.X
		Config.Size.Height = Main.AbsoluteSize.Y
	end

	Config.ScreenPadding = ScreenPadding
	Config.Opacity = GlobalOpacity

	saveConfig()
end

--// Fullscreen
local function applyFullscreen()
	if not IsFullscreen then
		return
	end

	Main.AnchorPoint = Vector2.new(0, 0)
	Main.Position = UDim2.fromOffset(ScreenPadding, ScreenPadding)

	Main.Size = UDim2.new(
		1,
		-(ScreenPadding * 2),
		1,
		-(ScreenPadding * 2)
	)
end

local function setFullscreen(Enabled)
	if Enabled == IsFullscreen then
		return
	end

	IsFullscreen = Enabled

	if IsFullscreen then
		LastPosition = Main.Position
		LastSize = Main.Size

		applyFullscreen()

		FullscreenButton.Text = "Restore"
		ResizePad.Visible = false
	else
		Main.AnchorPoint = Vector2.new(0.5, 0.5)
		Main.Position = LastPosition
		Main.Size = LastSize

		FullscreenButton.Text = "Fullscreen"
		ResizePad.Visible = true
	end

	saveWindowConfig()
end

--// Settings sliders
local MovingOpacity = false
local MovingPadding = false

local function setOpacity(Value)
	GlobalOpacity = math.clamp(Value, 0, 0.85)

	local Alpha = GlobalOpacity / 0.85

	OpacityFill.Size = UDim2.fromScale(Alpha, 1)
	OpacityKnob.Position = UDim2.new(Alpha, 0, 0.5, 0)
	OpacityValue.Text = tostring(math.floor(GlobalOpacity * 100 + 0.5)) .. "%"

	Config.Opacity = GlobalOpacity

	applyGlobalOpacity()
	saveConfig()
end

local function setPadding(Value)
	ScreenPadding = math.clamp(math.floor(Value + 0.5), 0, 100)

	local Alpha = ScreenPadding / 100

	PaddingFill.Size = UDim2.fromScale(Alpha, 1)
	PaddingKnob.Position = UDim2.new(Alpha, 0, 0.5, 0)
	PaddingValue.Text = tostring(ScreenPadding)

	if IsFullscreen then
		applyFullscreen()
	end

	Config.ScreenPadding = ScreenPadding
	saveConfig()
end

local function updateOpacityFromMouse(MouseX)
	local Position = OpacityTrack.AbsolutePosition
	local Size = OpacityTrack.AbsoluteSize

	if Size.X <= 0 then
		return
	end

	local Alpha = math.clamp(
		(MouseX - Position.X) / Size.X,
		0,
		1
	)

	setOpacity(Alpha * 0.85)
end

local function updatePaddingFromMouse(MouseX)
	local Position = PaddingTrack.AbsolutePosition
	local Size = PaddingTrack.AbsoluteSize

	if Size.X <= 0 then
		return
	end

	local Alpha = math.clamp(
		(MouseX - Position.X) / Size.X,
		0,
		1
	)

	setPadding(Alpha * 100)
end

