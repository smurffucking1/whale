local function selectPage(Name)
	if SelectedPage == Name then
		return
	end

	SelectedPage = Name

	for PageName, Page in pairs(PagesByName) do
		Page.Visible = PageName == Name
	end

	for TabName, Tab in pairs(TabsByName) do
		if TabName == Name then
			Tween(Tab, TweenPresets.Page, {
				BackgroundColor3 = Theme.Accent,
			})
		else
			Tween(Tab, TweenPresets.Page, {
				BackgroundColor3 = Theme.Tab,
			})
		end
	end

	PageTitle.Text = PageInfo[Name].Title
	PageSubtitle.Text = PageInfo[Name].Subtitle
end

