--// Picker input state
local PickerHue = 0
local PickerSaturation = 1
local PickerValue = 1
local PickerAlpha = 1

local ActiveColorCallback = nil
local ColorPickerOpen = false

local PickingSaturationValue = false
local PickingHue = false
local PickingAlpha = false

local function pickerColor()
	return Color3.fromHSV(PickerHue, PickerSaturation, PickerValue)
end

local function refreshPickerVisuals()
	local SelectedColor = pickerColor()

	SaturationValuePanel.BackgroundColor3 = Color3.fromHSV(
		PickerHue,
		1,
		1
	)

	AlphaColourLayer.BackgroundColor3 = SelectedColor
	ColorPreview.BackgroundColor3 = SelectedColor
	ColorPreview.BackgroundTransparency = 1 - PickerAlpha

	SaturationValueThumb.Position = UDim2.new(
		PickerSaturation,
		0,
		1 - PickerValue,
		0
	)

	HueThumb.Position = UDim2.new(
		0.5,
		0,
		PickerHue,
		0
	)

	AlphaThumb.Position = UDim2.new(
		PickerAlpha,
		0,
		0.5,
		0
	)

	AlphaLabel.Text = tostring(
		math.floor(PickerAlpha * 100 + 0.5)
	) .. "%"

	local R = math.floor(SelectedColor.R * 255 + 0.5)
	local G = math.floor(SelectedColor.G * 255 + 0.5)
	local B = math.floor(SelectedColor.B * 255 + 0.5)

	HexLabel.Text = string.format("#%02X%02X%02X", R, G, B)
end

local function setSaturationValue(MousePosition)
	local Position = SaturationValuePanel.AbsolutePosition
	local Size = SaturationValuePanel.AbsoluteSize

	if Size.X <= 0 or Size.Y <= 0 then
		return
	end

	PickerSaturation = math.clamp(
		(MousePosition.X - Position.X) / Size.X,
		0,
		1
	)

	PickerValue = 1 - math.clamp(
		(MousePosition.Y - Position.Y) / Size.Y,
		0,
		1
	)

	refreshPickerVisuals()
end

local function setHue(MousePosition)
	local Position = HueTrack.AbsolutePosition
	local Size = HueTrack.AbsoluteSize

	if Size.Y <= 0 then
		return
	end

	PickerHue = math.clamp(
		(MousePosition.Y - Position.Y) / Size.Y,
		0,
		1
	)

	refreshPickerVisuals()
end

local function setAlpha(MousePosition)
	local Position = AlphaTrack.AbsolutePosition
	local Size = AlphaTrack.AbsoluteSize

	if Size.X <= 0 then
		return
	end

	PickerAlpha = math.clamp(
		(MousePosition.X - Position.X) / Size.X,
		0,
		1
	)

	refreshPickerVisuals()
end

local function closeColorPicker()
	ActiveColorCallback = nil
	ColorPickerOpen = false

	PickingSaturationValue = false
	PickingHue = false
	PickingAlpha = false

	ColorModal.Visible = false
	ModalDim.Visible = false
end

local function openColorPicker(TitleText, StartingColor, StartingAlpha, Callback)
	local Hue, Saturation, Value = StartingColor:ToHSV()

	PickerHue = Hue
	PickerSaturation = Saturation
	PickerValue = Value
	PickerAlpha = math.clamp(StartingAlpha or 1, 0, 1)

	ActiveColorCallback = Callback
	ColorPickerOpen = true

	ModalTitle.Text = TitleText
	refreshPickerVisuals()

	ModalDim.Visible = true
	ColorModal.Visible = true
end

