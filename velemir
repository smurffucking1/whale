local HasFileSystem =
	type(isfolder) == "function"
	and type(makefolder) == "function"
	and type(isfile) == "function"
	and type(readfile) == "function"
	and type(writefile) == "function"

local function deepCopy(Input)
	local Output = {}

	for Key, Value in pairs(Input) do
		if type(Value) == "table" then
			Output[Key] = deepCopy(Value)
		else
			Output[Key] = Value
		end
	end

	return Output
end

local function colorToTable(Color)
	return {
		R = math.floor(Color.R * 255 + 0.5),
		G = math.floor(Color.G * 255 + 0.5),
		B = math.floor(Color.B * 255 + 0.5),
	}
end

local function tableToColor(Data, Fallback)
	if type(Data) ~= "table" then
		return Fallback
	end

	if type(Data.R) ~= "number"
		or type(Data.G) ~= "number"
		or type(Data.B) ~= "number" then
		return Fallback
	end

	return Color3.fromRGB(
		math.clamp(Data.R, 0, 255),
		math.clamp(Data.G, 0, 255),
		math.clamp(Data.B, 0, 255)
	)
end

