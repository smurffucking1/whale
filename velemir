local function CreateColourRow(Parent, DisplayName, ThemeKey, Description)
	local Card = CreateCard(Parent, 76)

	local NameLabel = New("TextLabel", {
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -92, 0, 20),

		BackgroundTransparency = 1,
		Text = DisplayName,
		TextColor3 = Theme.Text,
		TextSize = 14,
		Font = Enum.Font.GothamSemibold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Card)

	New("TextLabel", {
		Position = UDim2.fromOffset(16, 36),
		Size = UDim2.new(1, -92, 0, 18),

		BackgroundTransparency = 1,
		Text = Description,
		TextColor3 = Theme.SubText,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Card)

	bindTheme(NameLabel, "TextColor3", "Text")

	local Swatch = New("Frame", {
		Position = UDim2.new(1, -81, 0.5, -15),
		Size = UDim2.fromOffset(30, 30),

		BackgroundColor3 = Theme[ThemeKey],
		BorderSizePixel = 0,
	}, Card)

	AddCorner(Swatch, 9)
	AddStroke(Swatch, Theme.White, 1, 0.70)

	bindTheme(Swatch, "BackgroundColor3", ThemeKey)
	bindOpacity(Swatch, "BackgroundTransparency", 0)

	local Eyedropper = New("TextButton", {
		Name = ThemeKey .. "Eyedropper",

		Position = UDim2.new(1, -43, 0.5, -15),
		Size = UDim2.fromOffset(30, 30),

		BackgroundColor3 = Theme.Tab,
		BorderSizePixel = 0,

		AutoButtonColor = false,
		Text = "⌁",
		TextColor3 = Theme.Text,
		TextSize = 18,
		Font = Enum.Font.GothamBold,
	}, Card)

	AddCorner(Eyedropper, 9)

	bindTheme(Eyedropper, "BackgroundColor3", "Tab")
	bindTheme(Eyedropper, "TextColor3", "Text")
	bindOpacity(Eyedropper, "BackgroundTransparency", 0)

	Eyedropper.MouseEnter:Connect(function()
		Tween(Eyedropper, TweenPresets.Hover, {
			BackgroundColor3 = Theme.Accent,
		})
	end)

	Eyedropper.MouseLeave:Connect(function()
		Tween(Eyedropper, TweenPresets.Hover, {
			BackgroundColor3 = Theme.Tab,
		})
	end)

	Eyedropper.MouseButton1Click:Connect(function()
		openColorPicker(
			"Edit " .. DisplayName,
			Theme[ThemeKey],
			1,
			function(NewColor, _NewAlpha)
				Theme[ThemeKey] = NewColor
				Config.Colors[ThemeKey] = colorToTable(NewColor)

				refreshThemeKey(ThemeKey)
				saveConfig()
			end
		)
	end)

	return Card
end

