--// Drag state
local Dragging = false
local DragStart
local DragOrigin

DragStrip.InputBegan:Connect(function(Input)
	if ColorPickerOpen or IsFullscreen then
		return
	end

	if Input.UserInputType ~= Enum.UserInputType.MouseButton1
		and Input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	Dragging = true
	DragStart = Input.Position
	DragOrigin = Main.Position
end)

--// Resize state
local Resizing = false
local ResizeStartMouse
local ResizeStartSize

ResizePad.InputBegan:Connect(function(Input)
	if ColorPickerOpen or IsFullscreen then
		return
	end

	if Input.UserInputType ~= Enum.UserInputType.MouseButton1
		and Input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	Resizing = true
	ResizeStartMouse = Input.Position
	ResizeStartSize = Main.AbsoluteSize
end)

--// Central movement handler
UserInputService.InputChanged:Connect(function(Input)
	if Input.UserInputType ~= Enum.UserInputType.MouseMovement
		and Input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	-- Colour-picker input has priority.
	if ColorPickerOpen then
		if PickingSaturationValue then
			setSaturationValue(Input.Position)
		end

		if PickingHue then
			setHue(Input.Position)
		end

		if PickingAlpha then
			setAlpha(Input.Position)
		end

		return
	end

	if MovingOpacity then
		updateOpacityFromMouse(Input.Position.X)
	end

	if MovingPadding then
		updatePaddingFromMouse(Input.Position.X)
	end

	if Dragging then
		local Delta = Input.Position - DragStart

		Main.Position = UDim2.new(
			DragOrigin.X.Scale,
			DragOrigin.X.Offset + Delta.X,
			DragOrigin.Y.Scale,
			DragOrigin.Y.Offset + Delta.Y
		)

		LastPosition = Main.Position
	end

	if Resizing then
		local Delta = Input.Position - ResizeStartMouse

		local NewWidth = math.clamp(
			ResizeStartSize.X + Delta.X,
			MIN_WIDTH,
			MAX_WIDTH
		)

		local NewHeight = math.clamp(
			ResizeStartSize.Y + Delta.Y,
			MIN_HEIGHT,
			MAX_HEIGHT
		)

		Main.Size = UDim2.fromOffset(NewWidth, NewHeight)
		LastSize = Main.Size
	end
end)

UserInputService.InputEnded:Connect(function(Input)
	if Input.UserInputType ~= Enum.UserInputType.MouseButton1
		and Input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if ColorPickerOpen then
		PickingSaturationValue = false
		PickingHue = false
		PickingAlpha = false
		return
	end

	local SaveWindow = Dragging or Resizing

	Dragging = false
	Resizing = false
	MovingOpacity = false
	MovingPadding = false

	if SaveWindow then
		saveWindowConfig()
	end
end)

--// Minimize/reopen/destroy
local function closeWindow()
	if not WindowOpen then
		return
	end

	WindowOpen = false

	local Closing = Tween(Main, TweenPresets.Close, {
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
	})

	Closing.Completed:Once(function()
		if ScreenGui and ScreenGui.Parent then
			Main.Visible = false
			OpenButton.Visible = true
		end
	end)
end

local function openWindow()
	if WindowOpen then
		return
	end

	WindowOpen = true
	OpenButton.Visible = false
	Main.Visible = true

	if IsFullscreen then
		applyFullscreen()
	else
		Main.Size = UDim2.fromOffset(0, 0)

		Tween(Main, TweenPresets.Open, {
			Size = LastSize,
		})
	end

	applyGlobalOpacity()
end

local function destroyUI()
	WindowOpen = false
	OpenButton.Visible = false

	saveWindowConfig()

	local Closing = Tween(Main, TweenPresets.Close, {
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
	})

	Closing.Completed:Once(function()
		if ScreenGui then
			ScreenGui:Destroy()
		end
	end)
end

