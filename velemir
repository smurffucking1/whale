--// Opacity registry
-- Every visual object that should fade with the global opacity is registered here.
-- Opacity affects only background layers; text remains readable.
local OpacityBindings = {}

local function bindOpacity(Object, PropertyName, BaseTransparency)
	table.insert(OpacityBindings, {
		Object = Object,
		Property = PropertyName,
		BaseTransparency = BaseTransparency or 0,
	})
end

local function applyGlobalOpacity()
	for Index = #OpacityBindings, 1, -1 do
		local Binding = OpacityBindings[Index]

		if not Binding.Object or not Binding.Object.Parent then
			table.remove(OpacityBindings, Index)
		else
			local FinalTransparency = Binding.BaseTransparency
				+ ((1 - Binding.BaseTransparency) * GlobalOpacity)

			pcall(function()
				Binding.Object[Binding.Property] = math.clamp(
					FinalTransparency,
					0,
					1
				)
			end)
		end
	end
end

--// Theme registry
local ThemeBindings = {
	Background = {},
	Card = {},
	Accent = {},
	Tab = {},
	Text = {},
}

local function bindTheme(Object, PropertyName, ThemeKey)
	table.insert(ThemeBindings[ThemeKey], {
		Object = Object,
		Property = PropertyName,
	})
end

local function refreshThemeKey(ThemeKey)
	local Bindings = ThemeBindings[ThemeKey]

	for Index = #Bindings, 1, -1 do
		local Binding = Bindings[Index]

		if not Binding.Object or not Binding.Object.Parent then
			table.remove(Bindings, Index)
		else
			pcall(function()
				Binding.Object[Binding.Property] = Theme[ThemeKey]
			end)
		end
	end
end

