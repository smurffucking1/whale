		Accent = { R = 148, G = 82, B = 255 },
		Tab = { R = 35, G = 35, B = 45 },
		Text = { R = 245, G = 243, B = 250 },
	},
}

local Config = deepCopy(DefaultConfig)

local function loadConfig()
	if not HasFileSystem then
		return
	end

	pcall(function()
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end

		if not isfile(CONFIG_FILE) then
			writefile(CONFIG_FILE, HttpService:JSONEncode(DefaultConfig))
			return
		end

		local Decoded = HttpService:JSONDecode(readfile(CONFIG_FILE))

		if type(Decoded) ~= "table" then
			return
		end

		for Key, Value in pairs(Decoded) do
			Config[Key] = Value
		end

		Config.Position = Config.Position or deepCopy(DefaultConfig.Position)
		Config.Size = Config.Size or deepCopy(DefaultConfig.Size)
		Config.Colors = Config.Colors or {}

		for Key, Value in pairs(DefaultConfig.Colors) do
			if type(Config.Colors[Key]) ~= "table" then
				Config.Colors[Key] = Value
			end
		end
	end)
end

local function saveConfig()
	if not HasFileSystem then
		return
	end

	pcall(function()
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end

		writefile(CONFIG_FILE, HttpService:JSONEncode(Config))
	end)
end

